%-------------------------------------------------------------
\begin{frame}{What This Comparison Shows}
\begin{itemize}
    \item Our example is tiny
    \item LLMs are huge
    \item But the pipeline is identical:
\end{itemize}

\[
\text{Text}
\rightarrow
\text{Tokens}
\rightarrow
\text{IDs}
\rightarrow
\text{Embeddings}
\rightarrow
\text{Model}
\rightarrow
\text{Next Token}
\]
\end{frame}

%-------------------------------------------------------------
\begin{frame}{Key Takeaways}
\begin{itemize}
    \item NLP = converting text to numbers
    \item Embeddings = learned numeric features
    \item Context window = model history
    \item Our example is small
    \item LLMs scale the same math to trillions
\end{itemize}
\end{frame}

