      "text": "Demo: reproducing OpenAI's GPT-2",
      "fontSize": 23.055336129321223,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Demo: reproducing OpenAI's GPT-2",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "JSPrqGtCm58JiOz7L8TwP",
      "type": "text",
      "x": 3061.0701802699277,
      "y": 392.41582107790424,
      "width": 576.6593506336212,
      "height": 324,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4W",
      "roundness": null,
      "seed": 1012401266,
      "version": 374,
      "versionNonce": 876736174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1733952419972,
      "link": null,
      "locked": false,
      "text": "GPT-2 was published by OpenAI in 2019\nPaper: \"Language Models are Unsupervised Multitask Learners\"\n\nTransformer neural network with:\n- 1.6 billion parameters\n- maximum context length of 1024 tokens\n- trained on about 100 billion tokens\n\nMy reproduction with llm.c:\nhttps://github.com/karpathy/llm.c/discussions/677\n\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPT-2 was published by OpenAI in 2019\nPaper: \"Language Models are Unsupervised Multitask Learners\"\n\nTransformer neural network with:\n- 1.6 billion parameters\n- maximum context length of 1024 tokens\n- trained on about 100 billion tokens\n\nMy reproduction with llm.c:\nhttps://github.com/karpathy/llm.c/discussions/677\n\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
