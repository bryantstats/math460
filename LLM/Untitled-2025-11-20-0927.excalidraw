      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Human: \"What is 2+2?\"\nAssistant: \"2+2 = 4\"\nHuman: \"What if it was * instead of +?\"\nAssistant: \"2*2 = 4, same as 2+2!\"",
      "autoResize": false,
      "lineHeight": 1.35
    },
