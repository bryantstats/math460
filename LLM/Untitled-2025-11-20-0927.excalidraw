    },
    {
      "id": "4xeQN_L0Tx2q2eO6VAiV2",
      "type": "text",
      "x": 1798.6225489879462,
      "y": 5017.147165276948,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5Z",
      "roundness": null,
      "seed": 405185997,
      "version": 1784,
      "versionNonce": 2086742608,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "!!! \"Vague recollection\" vs. \"Working memory\" !!!",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "!!! \"Vague recollection\" vs. \"Working memory\" !!!",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LMOMYBu_GKGQ7zgoJYJSN",
      "type": "text",
      "x": 1793.3882893647228,
      "y": 5070.2277807731625,
      "width": 1520.71142578125,
      "height": 97.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5a",
      "roundness": null,
      "seed": 1652217411,
      "version": 337,
      "versionNonce": 1365729360,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "Knowledge in the parameters == Vague recollection (e.g. of something you read 1 month ago)\nKnowledge in the tokens of the context window == Working memory",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Knowledge in the parameters == Vague recollection (e.g. of something you read 1 month ago)\nKnowledge in the tokens of the context window == Working memory",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "i-SRHa1H0eqIBBcMPose6",
      "type": "text",
      "x": 1801.7869110901975,
      "y": 5277.649285011623,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5b",
      "roundness": null,
      "seed": 297112227,
      "version": 1862,
      "versionNonce": 1412879952,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "Knowledge of self",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Knowledge of self",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "alpvSb5p8SihLdYVcwY8T",
      "type": "text",
      "x": 1814.328405895215,
      "y": 5339.251569283529,
      "width": 1340.1103235556943,
      "height": 291.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5c",
      "roundness": null,
      "seed": 1572790851,
      "version": 538,
      "versionNonce": 2041023568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "The LLM has no knowledge of self \"out of the box\"\nIf you do nothing, it will probably think it is ChatGPT, developed by OpenAI.\nYou can program a \"sense of self\" in ~2 ways:\n- hardcoded conversations around these topics in the Conversations data.\n- \"system message\" that reminds the model at the beginning of every\nconversation about its identity.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The LLM has no knowledge of self \"out of the box\"\nIf you do nothing, it will probably think it is ChatGPT, developed by OpenAI.\nYou can program a \"sense of self\" in ~2 ways:\n- hardcoded conversations around these topics in the Conversations data.\n- \"system message\" that reminds the model at the beginning of every conversation about its identity.",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "2pi4Lsv4pgueim67Cj_bs",
      "type": "text",
      "x": 1801.7559770432554,
      "y": 5712.957680330845,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5d",
      "roundness": null,
      "seed": 1931559245,
      "version": 1937,
      "versionNonce": 1536262736,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "Models need tokens to think",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Models need tokens to think",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "a4gdaDC0wZeCtsoq__39y",
      "type": "text",
      "x": 1967.5355505862926,
      "y": 5818.316487792408,
      "width": 876.9299335523165,
      "height": 145.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5e",
      "roundness": null,
      "seed": 203332803,
      "version": 189,
      "versionNonce": 416069712,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "Human: \"Emily buys 3 apples and 2 oranges. Each\norange costs $2. The total cost of all the fruit is $13.\nWhat is the cost of apples?\"",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Human: \"Emily buys 3 apples and 2 oranges. Each orange costs $2. The total cost of all the fruit is $13. What is the cost of apples?\"",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "-HVmTutXrE4bXTsesnVHT",
      "type": "text",
      "x": 1711.509465792361,
      "y": 6031.178900734025,
      "width": 637.4197369273902,
      "height": 194.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5f",
      "roundness": null,
      "seed": 2036947011,
      "version": 475,
      "versionNonce": 892415568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "Assistant: \"The answer is $3. This is\nbecause 2 oranges at $2 are $4 total.\nSo the 3 apples cost $9, and therefore\neach apple is 9/3 = $3\".",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assistant: \"The answer is $3. This is because 2 oranges at $2 are $4 total. So the 3 apples cost $9, and therefore each apple is 9/3 = $3\".",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "uiDzmsHnwT5x30_7r2gH6",
      "type": "text",
      "x": 2434.5089688993403,
      "y": 6026.838456619911,
      "width": 637.4197369273902,
      "height": 194.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5g",
      "roundness": null,
      "seed": 633332845,
      "version": 689,
      "versionNonce": 2039931984,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763654592427,
      "link": null,
      "locked": false,
      "text": "Assistant: \"The total cost of the\noranges is $4. 13 - 4 = 9, the cost of\nthe 3 apples is $9. 9/3 = 3, so each\napple costs $3. The answer is $3\".",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assistant: \"The total cost of the oranges is $4. 13 - 4 = 9, the cost of the 3 apples is $9. 9/3 = 3, so each apple costs $3. The answer is $3\".",
      "autoResize": false,
      "lineHeight": 1.35
    },
