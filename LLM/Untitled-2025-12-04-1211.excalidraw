      "seed": 228843151,
      "version": 656,
      "versionNonce": 1846770159,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1764869271598,
      "link": null,
      "locked": false,
      "text": "WHERE TO KEEP TRACK OF THEM\n\n- reference https://lmarena.ai/\n- subscribe to https://buttondown.com/ainews\n- X / Twitter\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE TO KEEP TRACK OF THEM\n\n- reference https://lmarena.ai/\n- subscribe to https://buttondown.com/ainews\n- X / Twitter\n\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "mqZKYvUOigQohsamef7wi",
      "type": "text",
      "x": 554.735558174857,
      "y": 11203.160177948801,
      "width": 1206.323486328125,
      "height": 437.40000000000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA7",
      "roundness": null,
      "seed": 1038562479,
      "version": 811,
      "versionNonce": 1248632961,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1764869271598,
      "link": null,
      "locked": false,
      "text": "PREVIEW OF THINGS TO COME\n\n- multimodal (not just text but audio, images, video, natural conversations)\n- tasks -> agents (long, coherent, error-correcting contexts)\n- pervasive, invisible\n- computer-using\n- test-time training?, etc.\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PREVIEW OF THINGS TO COME\n\n- multimodal (not just text but audio, images, video, natural conversations)\n- tasks -> agents (long, coherent, error-correcting contexts)\n- pervasive, invisible\n- computer-using\n- test-time training?, etc.\n\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "TRoVGbzR2AG9VcXGNGOmz",
      "type": "text",
      "x": 1956.3510457596767,
      "y": 11207.633855296728,
      "width": 1322.063720703125,
      "height": 388.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA8",
      "roundness": null,
      "seed": 1402652367,
      "version": 1001,
      "versionNonce": 1485595663,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1764869271598,
      "link": null,
      "locked": false,
      "text": "WHERE TO FIND THEM\n\n- Proprietary models: on the respective websites of the LLM providers\n- Open weights models (DeepSeek, Llama): an inference provider, e.g. TogetherAI\n- Run them locally! LMStudio\n\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE TO FIND THEM\n\n- Proprietary models: on the respective websites of the LLM providers\n- Open weights models (DeepSeek, Llama): an inference provider, e.g. TogetherAI\n- Run them locally! LMStudio\n\n\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
