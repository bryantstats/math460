    {
      "id": "BaHyfD4_bBfDdVXZYQtZQ",
      "type": "text",
      "x": 542.1242673296056,
      "y": 9689.737638228518,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA1",
      "roundness": null,
      "seed": 883766255,
      "version": 2548,
      "versionNonce": 2137234209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764868768085,
      "link": null,
      "locked": false,
      "text": "RLHF upside",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RLHF upside",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Y9zlo8ihYmje92qJYeg-k",
      "type": "text",
      "x": 544.2972159296851,
      "y": 9762.799700166108,
      "width": 1168.0468749999989,
      "height": 340.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA2",
      "roundness": null,
      "seed": 1474223631,
      "version": 930,
      "versionNonce": 224759553,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764868768085,
      "link": null,
      "locked": false,
      "text": "We can run RL, in arbitrary domains! (even the unverifiable ones)\nThis (empirically) improves the performance of the model, possibly due\nto the \"discriminator - generator gap\":\n\nIn many cases, it is much easier to discriminate than to generate.\n\ne.g. \"Write a poem\" vs. \"Which of these 5 poems is best?\"",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can run RL, in arbitrary domains! (even the unverifiable ones)\nThis (empirically) improves the performance of the model, possibly due to the \"discriminator - generator gap\":\n\nIn many cases, it is much easier to discriminate than to generate.\n\ne.g. \"Write a poem\" vs. \"Which of these 5 poems is best?\"",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "94LnVMheY3D5hrGEw6STA",
      "type": "text",
      "x": 543.8343468803378,
      "y": 10258.634480872555,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA3",
      "roundness": null,
      "seed": 395723823,
      "version": 2610,
      "versionNonce": 314443489,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764868768085,
      "link": null,
      "locked": false,
      "text": "RLHF downside",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RLHF downside",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "s8PBgSoe3j9l2DUWc5E2g",
      "type": "text",
      "x": 543.3949300118293,
      "y": 10328.85307622582,
      "width": 1168.0468749999989,
      "height": 486,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA4",
      "roundness": null,
      "seed": 1404823119,
      "version": 1632,
      "versionNonce": 1778156225,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764868768085,
      "link": null,
      "locked": false,
      "text": "We are doing RL with respect to a lossy simulation of humans. It might\nbe misleading!\n\nEven more subtle:\nRL discovers ways to \"game\" the model.\nIt discovers \"adversarial examples\" of the reward model.\n\nE.g. after 1,000 updates, the top joke about pelicans is not the banger\nyou want, but something totally non-sensical like \"the the the the the\nthe the the\".",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We are doing RL with respect to a lossy simulation of humans. It might be misleading!\n\nEven more subtle:\nRL discovers ways to \"game\" the model.\nIt discovers \"adversarial examples\" of the reward model.\n\nE.g. after 1,000 updates, the top joke about pelicans is not the banger you want, but something totally non-sensical like \"the the the the the the the the\".",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "w-YiTVRq1JsoYg-_DhBxK",
