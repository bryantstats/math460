    },
    {
      "id": "5pVsoySVsOrPp-H88B7KX",
      "type": "text",
      "x": 3060.8267848558166,
      "y": 922.0909204584528,
      "width": 776.1800498874408,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 1237685358,
      "version": 238,
      "versionNonce": 1986238130,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1734043136767,
      "link": null,
      "locked": false,
      "text": "- OpenAI GPT-2 (2019): 1.6 billion parameters trained on 100 billion tokens\n- Llama 3 (2024): 405 billion parameters trained on 15 trillion tokens\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- OpenAI GPT-2 (2019): 1.6 billion parameters trained on 100 billion tokens\n- Llama 3 (2024): 405 billion parameters trained on 15 trillion tokens\n",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "_KkgVLaTPHxIwQWTukFCd",
      "type": "text",
      "x": 3062.128956094262,
      "y": 1008.305044898548,
      "width": 734.1888573308506,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4b",
      "roundness": null,
      "seed": 1115924722,
      "version": 337,
      "versionNonce": 1673739566,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1733952853342,
      "link": null,
      "locked": false,
      "text": "What is a release of a model?\n1) The code for running the Transformer  (e.g. 200 lines of code in Python)\n2) The parameters of the Transformer      (e.g. 1.6 billion numbers)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is a release of a model?\n1) The code for running the Transformer  (e.g. 200 lines of code in Python)\n2) The parameters of the Transformer      (e.g. 1.6 billion numbers)",
      "autoResize": false,
      "lineHeight": 1.35
    },
