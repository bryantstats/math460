    {
      "id": "92CKGDiVIkYAA8uUflnPs",
      "type": "text",
      "x": 3348.709671393801,
      "y": 11202.971372474793,
      "width": 743.3997032642365,
      "height": 340.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA6",
