    {
      "id": "BZ1a4miWVkmupSEbc0JE6",
      "type": "text",
      "x": 2817.6989982951345,
      "y": 9268.36685596945,
      "width": 965.2315766811371,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
